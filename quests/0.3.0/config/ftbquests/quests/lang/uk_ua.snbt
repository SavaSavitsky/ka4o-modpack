{
	chapter_group.48F77991D97F6751.title: "Початок і затишна база"
	chapter_group.45E9682208381DA9.title: "Техніка та магія"
	chapter_group.4D4A3B2D68D21D80.title: "Пригоди та великі боси"
	file.0000000000000001.title: "Ka4o Adventures — книга пригод"
	chapter.4108A3E56A8CBDD6.title: "Перші кроки"
	chapter.4108A3E56A8CBDD6.chapter_subtitle: [
		"Як користуватися книгою, підготуватися до пригод і грати разом."
	]
	quest.4ED707D930A8D649.title: "Ласкаво просимо до Ka4o Adventures"
	quest.4ED707D930A8D649.quest_desc: [
		"Ця книга — добровільний маршрут розвитку. Розділи можна проходити паралельно. Предмети для завдань не вилучаються: достатньо потримати їх у власному інвентарі. Галочкою позначено завдання, які ти підтверджуєш самостійно. Відкрий опис і натисни галочку в завданні."
	]
	task.4933710E8CC55137.title: "Підтвердити виконання вручну"
	quest.42157C325C758FCA.title: "Рецепт завжди під рукою"
	quest.42157C325C758FCA.quest_desc: [
		"Відкрий інвентар. JEI показує предмети збоку: R над предметом відкриває рецепт, U — використання. Пошук @create або @ars_nouveau обмежує список відповідним модом. Перевір рецепт будь-якого майбутнього механізму."
	]
	task.4E1410128651F703.title: "Підтвердити виконання вручну"
	quest.48E5176A3814FBA5.title: "Залізний запас"
	quest.48E5176A3814FBA5.quest_desc: [
		"Збери 16 залізних злитків. Залізо потрібне для інструментів, першої техніки та підготовки до данжів."
	]
	task.4B7656C61C859CBA.title: "Мати предмети у своєму інвентарі"
	reward.474F5C628F7AEC3A.title: "Досвід за виконання"
	quest.4C47D7958C421970.title: "Краще зі щитом"
	quest.4C47D7958C421970.quest_desc: [
		"Зроби щит і перевір його використання. Візьми запас їжі та блоків; модові боси можуть мати атаки, які не блокуються звичайним щитом."
	]
	task.4293937A5DA88493.title: "Мати предмети у своєму інвентарі"
	reward.45C7F9846FB91CFE.title: "Досвід за виконання"
	quest.49E52CFC9C8AD8BE.title: "Місце для відпочинку"
	quest.49E52CFC9C8AD8BE.quest_desc: [
		"Підготуй червоне ліжко. Воно задає точку відродження у звичайному світі. У небезпечних вимірах спершу перевір, чи дозволений сон; не використовуй ліжко в Незері або Енді."
	]
	task.4A762ECFDCB744C3.title: "Мати предмети у своєму інвентарі"
	reward.466BBE84147DBFA2.title: "Досвід за виконання"
	quest.4C428E2C1545F5FD.title: "Дім, до якого можна повернутися"
	quest.4C428E2C1545F5FD.quest_desc: [
		"На сервері виконай /sethome біля безпечної бази. /home повертає додому. Для телепортації до друга використовуй /tpa Нік; прийняття — кнопкою в чаті або /tpaccept id. В одиночній грі ці серверні команди можуть бути недоступні."
	]
	task.4D8572E8D0ACCED0.title: "Підтвердити виконання вручну"
	quest.448C291F4F4033D0.title: "Разом зручніше"
	quest.448C291F4F4033D0.quest_desc: [
		"FTB Quests підтримує спільний прогрес через команди FTB Teams. Якщо хочете спільну пригоду, створіть групу та запросіть друзів через меню команди. Якщо хочете власний прогрес — залишайтеся окремими. Нагороди досвіду не є нагородами ресурсами."
	]
	task.44462A1BA0817EBA.title: "Підтвердити виконання вручну"
	chapter.4C6715832573DCD6.title: "База без сотні скринь"
	chapter.4C6715832573DCD6.chapter_subtitle: [
		"Tom’s Storage, рюкзаки та зручне зберігання."
	]
	quest.4984F7D2404F5380.title: "Один вхід до сховища"
	quest.4984F7D2404F5380.quest_desc: [
		"Створи Inventory Connector за рецептом JEI і розмісти біля сховищ. Tom’s Storage дає спільний доступ до предметів, які залишаються у під’єднаних інвентарях."
	]
	task.4C4D916E28E2120D.title: "Мати предмети у своєму інвентарі"
	reward.494191CC84FE9D58.title: "Досвід за виконання"
	quest.4CEAB4D40155E5E6.title: "Знайти будь-яку річ"
	quest.4CEAB4D40155E5E6.quest_desc: [
		"Під’єднай Storage Terminal до мережі. Перевір пошук предметів. Якщо скрині не видно, перевір розташування з’єднувача й кабелів."
	]
	task.44EE323549718C3B.title: "Мати предмети у своєму інвентарі"
	reward.4C2F82131F69CE96.title: "Досвід за виконання"
	quest.4141703751D794A7.title: "Дотягнутися до сусідньої кімнати"
	quest.4141703751D794A7.quest_desc: [
		"Виготов кабелі для розширення мережі. Для під’єднання віддалених інвентарів можуть знадобитися кабельні з’єднувачі; дивись підказки предметів."
	]
	task.4B0170BEB5B432DA.title: "Мати предмети у своєму інвентарі"
	reward.453AD5F21F13BB68.title: "Досвід за виконання"
	quest.44E3BFB90177F785.title: "Крафт із загального запасу"
	quest.44E3BFB90177F785.quest_desc: [
		"Заміни або доповни звичайний термінал терміналом крафту. Спробуй перенести рецепт із JEI та створити предмет із ресурсів мережі."
	]
	task.4207C3744B5151AE.title: "Мати предмети у своєму інвентарі"
	reward.495FEC40D893AABD.title: "Досвід за виконання"
	quest.4B9BDF743AE25362.title: "Сховище в кишені"
	quest.4B9BDF743AE25362.quest_desc: [
		"Створи бездротовий термінал і прив’яжи його згідно з підказкою предмета. Дальність та додаткові умови перевір у вашій версії мода."
	]
	task.4862157AB188E89D.title: "Мати предмети у своєму інвентарі"
	reward.499BAB963FFB6B87.title: "Досвід за виконання"
	quest.42ED10E998C24DDD.title: "Рюкзак дослідника"
	quest.42ED10E998C24DDD.quest_desc: [
		"Зроби рюкзак. Його можна покращувати та використовувати для спорядження експедиції. Перевір призначення клавіші відкриття у керуванні."
	]
	task.4419B30AFCACDF31.title: "Мати предмети у своєму інвентарі"
	reward.498F41430122C48C.title: "Досвід за виконання"
	quest.4E945441C4FAD83B.title: "Більше місця для здобичі"
	quest.4E945441C4FAD83B.quest_desc: [
		"Покращ рюкзак до залізного. Перед оновленням прочитай рецепт і переконайся, що використовуєш власний рюкзак."
	]
	task.4DA9F30D257906B3.title: "Мати предмети у своєму інвентарі"
	reward.45FB42990021B20A.title: "Досвід за виконання"
	quest.482A6BAAC7AB0139.title: "Підбирати потрібне автоматично"
	quest.482A6BAAC7AB0139.quest_desc: [
		"Додай покращення підбирання та налаштуй фільтр. Не заповнюй увесь рюкзак каменем, якщо вирушаєш за рідкісною здобиччю."
	]
	task.4EB638FAB87C3710.title: "Мати предмети у своєму інвентарі"
	reward.41ACE61AB66346D3.title: "Досвід за виконання"
	quest.403C7A1152625262.title: "Експедиція надовго"
	quest.403C7A1152625262.quest_desc: [
		"Підготуй золотий рюкзак. Частину місця залиш для їжі, факелів і блоків, а знайдені артефакти складай окремо."
	]
	task.4599C72F099698D9.title: "Мати предмети у своєму інвентарі"
	reward.4D2EEB1094BDC105.title: "Досвід за виконання"
	chapter.491710A1EABB08AE.title: "Кухня Farmer’s Delight"
	chapter.491710A1EABB08AE.chapter_subtitle: [
		"Власна ферма, інструменти кухаря та ситні страви."
	]
	quest.4DBFAF4D1B6BD854.title: "Перший кухонний інструмент"
	quest.4DBFAF4D1B6BD854.quest_desc: [
		"Зроби кременевий ніж. Ножі використовуються з дошкою для нарізання та допомагають отримувати додаткові матеріали."
	]
	task.4EF3DDE87C1F59DB.title: "Мати предмети у своєму інвентарі"
	reward.49DD1024342327B5.title: "Досвід за виконання"
	quest.45D3EFE7DE542A44.title: "Робоче місце кухаря"
	quest.45D3EFE7DE542A44.quest_desc: [
		"Встанови дошку для нарізання. Перевір її рецепти в JEI: вони показують потрібний предмет і відповідний інструмент."
	]
	task.4F4BEFC440E6E204.title: "Мати предмети у своєму інвентарі"
	reward.453F1B2EA6FB74CE.title: "Досвід за виконання"
	quest.4B179CE31F95725C.title: "Солома теж ресурс"
	quest.4B179CE31F95725C.quest_desc: [
		"Здобудь солому способом, указаним у JEI. Вона використовується для мотузок, будівництва й фермерських предметів."
	]
	task.4FF0ED4E6478EC3E.title: "Мати предмети у своєму інвентарі"
	reward.439D9FC3B85682F6.title: "Досвід за виконання"
	quest.4EA36450F7AC59E5.title: "Поле під водою"
	quest.4EA36450F7AC59E5.quest_desc: [
		"Знайди дикий рис і почни вирощування. Підготуй придатну ділянку та перевір умови посадки."
	]
	task.49F8EF219D6BF012.title: "Мати предмети у своєму інвентарі"
	reward.478FFF132116FBDB.title: "Досвід за виконання"
	quest.4B6135E1684A0F11.title: "Помідори для майбутньої кухні"
	quest.4B6135E1684A0F11.quest_desc: [
		"Знайди дикі рослини, отримай насіння та заклади невелику ферму помідорів."
	]
	task.4C6610995D818E4C.title: "Мати предмети у своєму інвентарі"
	reward.4512F1B4C9D3A238.title: "Досвід за виконання"
	quest.4CB6C49F742A69F8.title: "Казанок на вогні"
	quest.4CB6C49F742A69F8.quest_desc: [
		"Створи казанок і постав над сумісним джерелом тепла. Для більшості готових страв потрібні інгредієнти та посуд."
	]
	task.4E622EE4519AA662.title: "Мати предмети у своєму інвентарі"
	reward.42D85FE6C6F8DF52.title: "Досвід за виконання"
	quest.4A92EFA11507342C.title: "Гаряча страва після походу"
	quest.4A92EFA11507342C.quest_desc: [
		"Приготуй овочевий суп. Це завдання перевіряє готову страву, але не забирає її."
	]
	task.445DE92322706AE1.title: "Мати предмети у своєму інвентарі"
	reward.4C173FCC87F5C2ED.title: "Досвід за виконання"
	quest.4E04E48D02809FC1.title: "Обід для компанії"
	quest.4E04E48D02809FC1.quest_desc: [
		"Приготуй велику страву із запеченою куркою для друзів. Рецепт перевір у JEI; накрий стіл на базі."
	]
	task.49D59D9E8AF16568.title: "Мати предмети у своєму інвентарі"
	reward.44386846FADCA25F.title: "Досвід за виконання"
	chapter.42C11F708AF881E2.title: "Create: від колеса до фабрики"
	chapter.42C11F708AF881E2.chapter_subtitle: [
		"Обертання, обробка матеріалів, виробництво та потяги."
	]
	quest.47A0E81EE6B383F3.title: "З чого починається Create"
	quest.47A0E81EE6B383F3.quest_desc: [
		"Створи андезитовий сплав. Це основа багатьох ранніх механізмів; рецепт доступний через R у JEI."
	]
	task.4403344F8C7D324F.title: "Мати предмети у своєму інвентарі"
	reward.4EE6953A73AE7066.title: "Досвід за виконання"
	quest.462B8F863FE36964.title: "Передати обертання"
	quest.462B8F863FE36964.quest_desc: [
		"Виготов вали. Вони передають обертання вздовж осі; поєднуй їх із шестернями для поворотів і зміни швидкості."
	]
	task.437C765CF8DE390A.title: "Мати предмети у своєму інвентарі"
	reward.45FA50A024D9FBAA.title: "Досвід за виконання"
	quest.4C5B431DAB2AACE7.title: "Бачити навантаження"
	quest.4C5B431DAB2AACE7.quest_desc: [
		"Зроби окуляри інженера. З ними легше діагностувати механізми, швидкість і перевантаження мережі."
	]
	task.4404C5F14424792D.title: "Мати предмети у своєму інвентарі"
	reward.4CAA7FDB88F746F4.title: "Досвід за виконання"
	quest.44A4A1436744C27A.title: "Перша механічна енергія"
	quest.44A4A1436744C27A.quest_desc: [
		"Встанови водяне колесо так, щоб вода приводила його в рух. Воно дає обертання, а не електрику для AE2."
	]
	task.4C782D8D2BE79EC0.title: "Мати предмети у своєму інвентарі"
	reward.46F99ABE59EAFAC1.title: "Досвід за виконання"
	quest.49D14B682EB7B700.title: "Шестерні та швидкість"
	quest.49D14B682EB7B700.quest_desc: [
		"Підготуй малі шестерні. Спробуй поєднання малої та великої шестерні й спостерігай зміну швидкості."
	]
	task.4EC948DF58047F64.title: "Мати предмети у своєму інвентарі"
	reward.4D5A3FC5904AAFE5.title: "Досвід за виконання"
	quest.4AE749278DB779D8.title: "Механічний прес"
	quest.4AE749278DB779D8.quest_desc: [
		"Під’єднай прес до джерела обертання. Використай його для обробки матеріалів за рецептом JEI."
	]
	task.4F4087378F788D8D.title: "Мати предмети у своєму інвентарі"
	reward.444961A3F4FA1DE2.title: "Досвід за виконання"
	quest.4074D6E78FA068FF.title: "Перший лист металу"
	quest.4074D6E78FA068FF.quest_desc: [
		"Отримай залізні листи за допомогою преса. Вони потрібні для багатьох наступних пристроїв."
	]
	task.40DF56E713857099.title: "Мати предмети у своєму інвентарі"
	reward.485D2E4A7C2B6A2A.title: "Досвід за виконання"
	quest.4741C8E7D0BB0122.title: "Потік повітря"
	quest.4741C8E7D0BB0122.quest_desc: [
		"Створи вентилятор. Для промивання, копчення чи інших процесів потрібне відповідне середовище в потоці — дивись Ponder та JEI."
	]
	task.4DBB322854106E28.title: "Мати предмети у своєму інвентарі"
	reward.4B2D263D85F17A33.title: "Досвід за виконання"
	quest.4AF14252DCAAC08F.title: "Змішати за рецептом"
	quest.4AF14252DCAAC08F.quest_desc: [
		"Збери міксер із чашею Basin. Деякі рецепти потребують мінімальної швидкості та нагріву."
	]
	task.45956EF19E2F7180.title: "Мати предмети у своєму інвентарі"
	reward.4649815A1B6C71FB.title: "Досвід за виконання"
	quest.4905CFC1FB727510.title: "Епоха латуні"
	quest.4905CFC1FB727510.quest_desc: [
		"Отримай латунь за рецептом вашої збірки. Перевір потребу в нагріві й компонентах у JEI."
	]
	task.410C6ABB946C544A.title: "Мати предмети у своєму інвентарі"
	reward.47B13BF47E388B49.title: "Досвід за виконання"
	quest.479E292E08EE0E87.title: "Механічна рука"
	quest.479E292E08EE0E87.quest_desc: [
		"Створи Deployer. Він виконує дії предметом перед собою й використовується в послідовному складанні."
	]
	task.4934DF0D612474BF.title: "Мати предмети у своєму інвентарі"
	reward.43024FFA5E1ED37D.title: "Досвід за виконання"
	quest.46C424B991DFA751.title: "Точний механізм"
	quest.46C424B991DFA751.quest_desc: [
		"Виготов точний механізм через послідовне складання. Стеж за порядком кроків і кількістю повторень у JEI."
	]
	task.47A1301DE4C08A81.title: "Мати предмети у своєму інвентарі"
	reward.497968C4CAC92F7E.title: "Досвід за виконання"
	quest.4EE05DD257313155.title: "Крафт без рук"
	quest.4EE05DD257313155.quest_desc: [
		"Побудуй систему механічного крафту. Налаштуй напрямки виходу, підведи обертання й ресурси."
	]
	task.4C6069730A9CF4E0.title: "Мати предмети у своєму інвентарі"
	reward.4786BB84151C8EB9.title: "Досвід за виконання"
	quest.49D7C15B1AC1613B.title: "Дорога між базами"
	quest.49D7C15B1AC1613B.quest_desc: [
		"Підготуй рейки Create для майбутнього потяга. Для складання потяга потрібні також станція та відповідні візки."
	]
	task.41507A90AE1C7A97.title: "Мати предмети у своєму інвентарі"
	reward.445E7EA7FC5B5F04.title: "Досвід за виконання"
	quest.4248A1F6805FDD1D.title: "Фабрика, яка працює сама"
	quest.4248A1F6805FDD1D.quest_desc: [
		"Побудуй одну повністю автоматичну лінію: від подачі сировини до готового продукту в сховищі. Перевір переповнення, навантаження та вимкнення. Це будівельне завдання підтверджується вручну."
	]
	task.44B41C83C7758F65.title: "Підтвердити виконання вручну"
	chapter.437F8B205C5B832E.title: "Ars Nouveau: школа чарівника"
	chapter.437F8B205C5B832E.chapter_subtitle: [
		"Власні закляття, джерело магії та помічники."
	]
	quest.4B2FB283A00A7C07.title: "Записник мага"
	quest.4B2FB283A00A7C07.quest_desc: [
		"Створи Worn Notebook. Це внутрішній посібник мода: він пояснює ритуали, пристрої, гліфи та магічних істот."
	]
	task.42B26385574A2573.title: "Мати предмети у своєму інвентарі"
	reward.42BD78FCED0218CE.title: "Досвід за виконання"
	quest.431B9E99226305C8.title: "Перша книга заклять"
	quest.431B9E99226305C8.quest_desc: [
		"Створи книгу новачка. Відкрий її редактор і склади перше просте закляття з доступних гліфів."
	]
	task.46046E6D4455D82A.title: "Мати предмети у своєму інвентарі"
	reward.42B2051B66BAE382.title: "Досвід за виконання"
	quest.4C35D1012C08CB27.title: "Перетворення матеріалів"
	quest.4C35D1012C08CB27.quest_desc: [
		"Підготуй камеру насичення. Читай рецепт і умови у записнику: різні операції можуть вимагати предметів поруч."
	]
	task.4BF34454B508A4A1.title: "Мати предмети у своєму інвентарі"
	reward.41654FF6EF9C6467.title: "Досвід за виконання"
	quest.4ADA1C502384AD15.title: "Магія у кристалі"
	quest.4ADA1C502384AD15.quest_desc: [
		"Отримай Source Gems. Вони використовуються для магічних блоків і розвитку ремесла."
	]
	task.45D0F3A46BBE3DA2.title: "Мати предмети у своєму інвентарі"
	reward.4C77588BA8D602AB.title: "Досвід за виконання"
	quest.48BE4F578A4BF0C3.title: "Нові слова для заклять"
	quest.48BE4F578A4BF0C3.quest_desc: [
		"Створи стіл писаря. Він відкриває шлях до нових гліфів; перевір потрібні предмети й рівень книги."
	]
	task.4F82F7717EABA984.title: "Мати предмети у своєму інвентарі"
	reward.41100C48E6DB0596.title: "Досвід за виконання"
	quest.484B6D2DF2E68141.title: "Зберегти магічне джерело"
	quest.484B6D2DF2E68141.quest_desc: [
		"Постав Source Jar біля джерела генерації магічної енергії. Наповнення й радіуси роботи перевір у записнику."
	]
	task.47D4987CDD1FB264.title: "Мати предмети у своєму інвентарі"
	reward.4D86B710E751197C.title: "Досвід за виконання"
	quest.4479585D313A86D1.title: "Магія від фермерства"
	quest.4479585D313A86D1.quest_desc: [
		"Побудуй агрономічний Sourcelink біля ферми. Прочитай умови генерації та переконайся, що енергія надходить до банки."
	]
	task.47109C6EC79754DB.title: "Мати предмети у своєму інвентарі"
	reward.44EA24D2DE70CB98.title: "Досвід за виконання"
	quest.450CF873ABA1868A.title: "Магічне складання"
	quest.450CF873ABA1868A.quest_desc: [
		"Збери Enchanting Apparatus із необхідними постаментами та джерелом. Розкладай компоненти відповідно до рецепта."
	]
	task.41B553E3A0E58269.title: "Мати предмети у своєму інвентарі"
	reward.4DF719DE8E0FC11A.title: "Досвід за виконання"
	quest.40ED70468C33AFC2.title: "Зірковий помічник"
	quest.40ED70468C33AFC2.quest_desc: [
		"Підготуй Starbuncle Charm. Помічники можуть переносити предмети; правила призначення інвентарів описані в записнику."
	]
	task.4DDFF0D4AF90422D.title: "Мати предмети у своєму інвентарі"
	reward.4E2E8C81A7516F2A.title: "Досвід за виконання"
	quest.43F3DA143102A53B.title: "Наступний рівень чарівника"
	quest.43F3DA143102A53B.quest_desc: [
		"Покращ книгу до рівня учня. З’явиться доступ до складніших заклять і більшої кількості можливостей."
	]
	task.456FBBD9DDD800DB.title: "Мати предмети у своєму інвентарі"
	reward.4757682857377972.title: "Досвід за виконання"
	quest.4FDD6FF6D0868268.title: "Випробування дикої магії"
	quest.4FDD6FF6D0868268.quest_desc: [
		"Підготуй ритуал виклику Wilden Chimera за записником. Візьми захист і перевір спорядження перед боєм. Потрібна особиста перемога, зарахована системою вбивств."
	]
	task.4BB81B8DE9AE5E14.title: "Перемогти ціль"
	reward.4509FF774E42F82B.title: "Досвід за виконання"
	quest.4EC2DA11CFCF1AE2.title: "Книга архімага"
	quest.4EC2DA11CFCF1AE2.quest_desc: [
		"Створи книгу архімага та випробуй власну комбінацію заклять. Використовуй її як інструмент для подальших пригод."
	]
	task.432598C68F8B3564.title: "Мати предмети у своєму інвентарі"
	reward.464453727D886F76.title: "Досвід за виконання"
	chapter.4EC08528CBED52CF.title: "AE2: цифрова майстерня"
	chapter.4EC08528CBED52CF.chapter_subtitle: [
		"Від кристалів і процесорів до автокрафту."
	]
	quest.4AA33759FFDC587B.title: "Перший кварц Certus"
	quest.4AA33759FFDC587B.quest_desc: [
		"Знайди Certus Quartz. У цій версії AE2 звертай увагу на метеорити й кристалічні блоки; спосіб отримання дивись у JEI."
	]
	task.40D203B7F0002DD4.title: "Мати предмети у своєму інвентарі"
	reward.47D65FD0C8634098.title: "Досвід за виконання"
	quest.4042D6A0496D1822.title: "Матриця для логіки"
	quest.4042D6A0496D1822.quest_desc: [
		"Здобудь матрицю логічного процесора. Досліди скриню всередині метеорита та збережи знайдені матриці."
	]
	task.4110E440B81545C2.title: "Мати предмети у своєму інвентарі"
	reward.475D3C45C8C690DB.title: "Досвід за виконання"
	quest.4C8E5DBB9AA00319.title: "Зарядити кристал"
	quest.4C8E5DBB9AA00319.quest_desc: [
		"Створи зарядний пристрій і забезпеч його підтримуваною енергією. Ранні способи живлення перевір у посібнику AE2."
	]
	task.4A63E3810B8D7027.title: "Мати предмети у своєму інвентарі"
	reward.4A5948561E3524E7.title: "Досвід за виконання"
	quest.462A912E4D6C2E1E.title: "Кристал Fluix"
	quest.462A912E4D6C2E1E.quest_desc: [
		"Отримай Fluix Crystal за рецептом JEI. Уважно перевір, який із кристалів має бути зарядженим."
	]
	task.41F95C0D51A3FA0C.title: "Мати предмети у своєму інвентарі"
	reward.4541575A90C5F992.title: "Досвід за виконання"
	quest.46FE072BEF119709.title: "Народження процесора"
	quest.46FE072BEF119709.quest_desc: [
		"Створи Inscriber. За допомогою матриць виготовляються заготовки, які далі збираються в процесори."
	]
	task.43E4622AAB37DF1E.title: "Мати предмети у своєму інвентарі"
	reward.49E1828F5C86686D.title: "Досвід за виконання"
	quest.47AB58583E039920.title: "Логічний процесор"
	quest.47AB58583E039920.quest_desc: [
		"Збери логічний процесор. Читай обидва етапи рецепта в JEI, а не лише рецепт заготовки."
	]
	task.4EE00A0B25F140CF.title: "Мати предмети у своєму інвентарі"
	reward.46E6284D4234EDE7.title: "Досвід за виконання"
	quest.4E523A990F12A6E2.title: "Живлення мережі"
	quest.4E523A990F12A6E2.quest_desc: [
		"Постав Energy Acceptor і підведи сумісне живлення. Обертання Create не є електрикою саме по собі."
	]
	task.4114E5501313E9C1.title: "Мати предмети у своєму інвентарі"
	reward.4B84DCF40775A5BD.title: "Досвід за виконання"
	quest.4B58073B5C47EC8C.title: "Місце для комірок"
	quest.4B58073B5C47EC8C.quest_desc: [
		"Створи ME Drive. Він зберігає комірки даних, але для доступу до предметів ще потрібен термінал і робоча мережа."
	]
	task.4568C219332ABE35.title: "Мати предмети у своєму інвентарі"
	reward.44447913EC4F75ED.title: "Досвід за виконання"
	quest.420B30A57D8A0758.title: "Перші цифрові речі"
	quest.420B30A57D8A0758.quest_desc: [
		"Зроби комірку 1k. Вона має обмеження місткості та типів предметів; стеж за індикаторами сховища."
	]
	task.4EDC71076A68AAB3.title: "Мати предмети у своєму інвентарі"
	reward.4952B2450D0ECF65.title: "Досвід за виконання"
	quest.4AEBA8861F25747D.title: "Усе на одному екрані"
	quest.4AEBA8861F25747D.quest_desc: [
		"Під’єднай термінал крафту. Якщо він не працює, перевір енергію, кабель і канали."
	]
	task.4F5009E7921894B0.title: "Мати предмети у своєму інвентарі"
	reward.44C86A7307D3E4D7.title: "Досвід за виконання"
	quest.406D3E64504B4428.title: "Закодувати майбутній крафт"
	quest.406D3E64504B4428.quest_desc: [
		"Створи термінал кодування шаблонів. Крафтові та обробні шаблони мають різне призначення."
	]
	task.4FFEBD2C3C4792F8.title: "Мати предмети у своєму інвентарі"
	reward.4DC7500F59A5770E.title: "Досвід за виконання"
	quest.4740BC004BFCC955.title: "Автоматичне складання"
	quest.4740BC004BFCC955.quest_desc: [
		"Побудуй молекулярний складальник і під’єднай через потрібний компонент мережі. Одного складальника без шаблона та процесора недостатньо."
	]
	task.4CF233547DA46746.title: "Мати предмети у своєму інвентарі"
	reward.469E9D53C8123BA6.title: "Досвід за виконання"
	quest.4AB28AE1E7B4F58B.title: "Мозок автокрафту"
	quest.4AB28AE1E7B4F58B.quest_desc: [
		"Створи блок пам’яті крафту. Збери процесор крафту відповідно до посібника та перевір план невеликого замовлення."
	]
	task.44279229079E76D7.title: "Мати предмети у своєму інвентарі"
	reward.449873C74181678F.title: "Досвід за виконання"
	quest.43346896ACC6F316.title: "Від замовлення до результату"
	quest.43346896ACC6F316.quest_desc: [
		"Налаштуй автоматичне виготовлення хоча б одного корисного предмета й замов його з термінала. Перевір повернення результату в мережу. Підтвердження цього інженерного завдання — вручну."
	]
	task.4F85B7350C5CF3F8.title: "Підтвердити виконання вручну"
	chapter.4227427BADCB5429.title: "Iron’s Spells: бойова магія"
	chapter.4227427BADCB5429.chapter_subtitle: [
		"Сувої, спорядження, школи заклять і небезпечні суперники."
	]
	quest.44CDE866C5288F2A.title: "Чорнило для нових чарів"
	quest.44CDE866C5288F2A.quest_desc: [
		"Знайди або виготов звичайне магічне чорнило. Способи отримання й поліпшення перевір у JEI."
	]
	task.42710DB49384A52C.title: "Мати предмети у своєму інвентарі"
	reward.4D5361265CC01296.title: "Досвід за виконання"
	quest.42CD8F33F23AD5C9.title: "Власна бойова книга"
	quest.42CD8F33F23AD5C9.quest_desc: [
		"Підготуй залізну книгу заклять. Книги відрізняються місткістю й бонусами; потрібні закляття записуються окремо."
	]
	task.421E1F02BC21F765.title: "Мати предмети у своєму інвентарі"
	reward.44E8ECBCC5D25901.title: "Досвід за виконання"
	quest.45C9228EB983AD1E.title: "Записати сувій"
	quest.45C9228EB983AD1E.quest_desc: [
		"Створи стіл написання. Прочитай підказки інтерфейсу та перевір процедуру перенесення заклять у книгу."
	]
	task.4DB24094A1050E76.title: "Мати предмети у своєму інвентарі"
	reward.4120FC67C50442C0.title: "Досвід за виконання"
	quest.4F2358ED24B013B8.title: "Майстерня сувоїв"
	quest.4F2358ED24B013B8.quest_desc: [
		"Зроби Scroll Forge. Підбирай інгредієнти за рецептом конкретного закляття."
	]
	task.49C34F66A31E0E32.title: "Мати предмети у своєму інвентарі"
	reward.4FFC403216CF2E83.title: "Досвід за виконання"
	quest.40BCE47CCF717B03.title: "Алхімічний підхід"
	quest.40BCE47CCF717B03.quest_desc: [
		"Постав алхімічний казан. Перевір його застосування у рецептах чорнила та магічних матеріалів."
	]
	task.40ECFC55227D667F.title: "Мати предмети у своєму інвентарі"
	reward.43094F860EF5FF8C.title: "Досвід за виконання"
	quest.47C8A42D0B2A242D.title: "Рідкісні знання"
	quest.47C8A42D0B2A242D.quest_desc: [
		"Отримай рідкісне чорнило. Розвивай одну-дві школи магії, перш ніж витрачати всі ресурси на різні напрямки."
	]
	task.42353DFBDE07614F.title: "Мати предмети у своєму інвентарі"
	reward.42B7DFF688A7305C.title: "Досвід за виконання"
	quest.469CC36D7674187A.title: "Покращення спорядження"
	quest.469CC36D7674187A.quest_desc: [
		"Створи Arcane Anvil та вивчи його рецепти. Звертай увагу на сумісність покращення з конкретною річчю."
	]
	task.404C14069EA04CC7.title: "Мати предмети у своєму інвентарі"
	reward.456CF82FC0A34DE0.title: "Досвід за виконання"
	quest.42162755BC0311B2.title: "Книга досвідченого мага"
	quest.42162755BC0311B2.quest_desc: [
		"Покращ спорядження до алмазної книги. Візьми бойове закляття, засіб захисту та перевір витрати мани."
	]
	task.4D35A33C6586AAE3.title: "Мати предмети у своєму інвентарі"
	reward.47B0FF42EFA94839.title: "Досвід за виконання"
	quest.463EF3CE142B2D29.title: "Легендарне чорнило"
	quest.463EF3CE142B2D29.quest_desc: [
		"Здобудь легендарне чорнило. Не витрачай його навмання: заздалегідь перевір потрібний рецепт."
	]
	task.4584880C162BDD78.title: "Мати предмети у своєму інвентарі"
	reward.499451AC72C54D41.title: "Досвід за виконання"
	quest.41F2658303CA2141.title: "Випробувати власну школу"
	quest.41F2658303CA2141.quest_desc: [
		"Переможи небезпечного ворога, використовуючи зібрану бойову книгу. Порівняй витрати мани, перезарядку й мобільність. Це добровільне завдання підтверджується вручну."
	]
	task.4F6A9C93907CFE74.title: "Підтвердити виконання вручну"
	chapter.415B44652FBD76A9.title: "Данжі та великі подорожі"
	chapter.415B44652FBD76A9.chapter_subtitle: [
		"Nature’s Compass, Waystones, Lootr і When Dungeons Arise."
	]
	quest.42644724B81D42D5.title: "Біом, який ти шукаєш"
	quest.42644724B81D42D5.quest_desc: [
		"Створи Nature’s Compass. Відкрий вибір біомів, почни пошук і слідуй показникам. Компас шукає біоми, а не конкретні данжі."
	]
	task.4BC082321DF595F0.title: "Мати предмети у своєму інвентарі"
	reward.4F180EF2AC9CAB54.title: "Досвід за виконання"
	quest.4421AB2DFF431EC4.title: "Дорога назад"
	quest.4421AB2DFF431EC4.quest_desc: [
		"Підготуй Waystone та активуй камені в місцях, куди часто повертаєшся. Перевір вартість телепортації у вашій конфігурації."
	]
	task.49D1D8C76372634D.title: "Мати предмети у своєму інвентарі"
	reward.486022E1DB4B63C4.title: "Досвід за виконання"
	quest.495146D2AB833C37.title: "Запас для дослідника"
	quest.495146D2AB833C37.quest_desc: [
		"Підготуй щонайменше 32 факели. Додай їжу, блоки, щит і засіб повернення додому."
	]
	task.4CACF9A09B8B1536.title: "Мати предмети у своєму інвентарі"
	reward.42A7B4B524E79739.title: "Досвід за виконання"
	quest.44ABBB9CD7E6415F.title: "Зачистка перед входом"
	quest.44ABBB9CD7E6415F.quest_desc: [
		"Переможи п’ять зомбі. Бій у вузьких коридорах і з кількома ворогами відрізняється від битви на відкритій місцевості."
	]
	task.40AFFD351079891D.title: "Перемогти ціль"
	reward.4CE0FA3E8F76ACA7.title: "Досвід за виконання"
	quest.4F4730FDCE29A7DA.title: "Перша велика споруда"
	quest.4F4730FDCE29A7DA.quest_desc: [
		"Знайди й досліди одну споруду When Dungeons Arise. Вибери безпечний маршрут, познач вхід на карті та не забувай про відступ. Відвідання саме структури цього мода тут підтверджується вручну."
	]
	task.4636B9BD32FB6E5A.title: "Підтвердити виконання вручну"
	quest.4092A0A0BAA85741.title: "Скарб для кожного"
	quest.4092A0A0BAA85741.quest_desc: [
		"Відкрий підтримувану скриню Lootr, а потім попроси друга перевірити її. У кожного має бути власна здобич. Не всі скрині світу автоматично стають Lootr-скринями."
	]
	task.4CEE056C3048BA19.title: "Підтвердити виконання вручну"
	quest.49E5374113F35506.title: "Новий рівень небезпеки"
	quest.49E5374113F35506.quest_desc: [
		"Відвідай Незер. Візьми вогнестійкість, блоки та координати порталу; не намагайся спати в цьому вимірі."
	]
	task.418BBAC10858E04A.title: "Відвідати вимір"
	reward.401D36F7EEE1AE76.title: "Досвід за виконання"
	quest.4D5162EA21875D65.title: "Експедиція компанією"
	quest.4D5162EA21875D65.quest_desc: [
		"Разом зачистіть ще одну велику споруду. Домовтеся, хто лікує, хто тримає ворогів і хто збирає здобич. Поверніться з усіма учасниками; завдання підтверджується вручну."
	]
	task.4C6FE90CE95D77BA.title: "Підтвердити виконання вручну"
	chapter.493258D4D3898DE5.title: "Cataclysm: мисливці на босів"
	chapter.493258D4D3898DE5.chapter_subtitle: [
		"Незалежні виклики для добре підготовленої команди."
	]
	quest.46935DB1A2868E2D.title: "Підготовка важливіша за поспіх"
	quest.46935DB1A2868E2D.quest_desc: [
		"Візьміть зачаровану броню, їжу, зілля й запас блоків. Домовтеся про відступ та збережіть безпечну точку повернення. Наступні боси є окремими викликами, їх не потрібно проходити саме в порядку відображення."
	]
	task.4B75D3CD53A9ACAC.title: "Підтвердити виконання вручну"
	quest.476423BCAD555AF5.title: "Страж загублених руїн"
	quest.476423BCAD555AF5.quest_desc: [
		"Знайди Ендер-голема в спорудах мода та переможи його. Для зарахування потрібне вбивство, яке гра приписала гравцю."
	]
	task.4DB3BE4709F27272.title: "Перемогти ціль"
	reward.447C8E3CB3243C7F.title: "Досвід за виконання"
	quest.4BFAD3072A5021D8.title: "Вартовий Енду"
	quest.4BFAD3072A5021D8.quest_desc: [
		"Переможи Ender Guardian. Вивчай зони атак і не стій усією командою в одній точці."
	]
	task.49E62B28E8309F30.title: "Перемогти ціль"
	reward.41DB5F16FC5FF9A3.title: "Досвід за виконання"
	quest.441663CFA2984465.title: "Незеритова потвора"
	quest.441663CFA2984465.quest_desc: [
		"Переможи Netherite Monstrosity. Підготуй захист від вогню та уважно стеж за змінами поведінки боса."
	]
	task.49D51BD9F999CC6A.title: "Перемогти ціль"
	reward.48708C23A02F983C.title: "Досвід за виконання"
	quest.427FCDC6C921F7A3.title: "Провісник механічної загрози"
	quest.427FCDC6C921F7A3.quest_desc: [
		"Знайди й переможи Harbinger. Слідкуй за снарядами та залишай шлях для маневру."
	]
	task.4BA75E0F6BEBA8D3.title: "Перемогти ціль"
	reward.4707DC9B4395F121.title: "Досвід за виконання"
	quest.4D3754C90891E56C.title: "Володар глибин"
	quest.4D3754C90891E56C.quest_desc: [
		"Підготуй спорядження для підводної битви й переможи Leviathan. Перевір запас повітря та рухливість до початку бою."
	]
	task.452EB64F66835529.title: "Перемогти ціль"
	reward.4D64B375233869C1.title: "Досвід за виконання"
	quest.4DBA13014C0303BE.title: "Стародавній володар пустелі"
	quest.4DBA13014C0303BE.quest_desc: [
		"Переможи Ancient Remnant. Візьми достатньо ресурсів на тривалий бій і вивчай безпечні проміжки між атаками."
	]
	task.405F08BC98C8779E.title: "Перемогти ціль"
	reward.477DF35CAD686B0D.title: "Досвід за виконання"
	quest.46DD641E1FA3B164.title: "Вогняне випробування"
	quest.46DD641E1FA3B164.quest_desc: [
		"Переможи Ignis. Це пізній виклик; підготуй найкраще доступне спорядження та план дій на кожну фазу."
	]
	task.4AB44909B0D2B8C7.title: "Перемогти ціль"
	reward.480B342AD6411C05.title: "Досвід за виконання"
	quest.438AD49F1B2BC5B9.title: "Проклятий воїн"
	quest.438AD49F1B2BC5B9.quest_desc: [
		"Переможи Maledictus. Не покладайся лише на шкоду: рухливість і уважність до атак також важливі."
	]
	task.465E789DD57263B5.title: "Перемогти ціль"
	reward.44ECCACDAAE330D2.title: "Досвід за виконання"
	chapter.4A33FBE3A2C7A961.title: "Сутінковий ліс"
	chapter.4A33FBE3A2C7A961.chapter_subtitle: [
		"Новий вимір із власною послідовністю відкриття зон."
	]
	quest.411CE11C961AA10B.title: "Ключ до сутінків"
	quest.411CE11C961AA10B.quest_desc: [
		"Підготуй алмаз. Для стандартного порталу потрібен басейн води 2×2 в землі з рослинами по краях; кинь алмаз у воду й відійди від місця блискавки."
	]
	task.43D648732CFE3001.title: "Мати предмети у своєму інвентарі"
	reward.4C5381360BCCD655.title: "Досвід за виконання"
	quest.4539334F6DB443D7.title: "За межею звичайного світу"
	quest.4539334F6DB443D7.quest_desc: [
		"Увійди до Сутінкового лісу та познач портал на карті. Цей вимір має власну систему прогресії: захищені зони відкриваються після потрібних перемог і досягнень."
	]
	task.4092647447C9F3E4.title: "Відвідати вимір"
	reward.41534535AB7E4B28.title: "Досвід за виконання"
	quest.433A7B86AE59B9E3.title: "Мапа великих таємниць"
	quest.433A7B86AE59B9E3.quest_desc: [
		"Створи Magic Map. Вона показує важливі споруди Сутінкового лісу; рецепт фокуса карти дивись у JEI."
	]
	task.4FE2D3DE6CC38F7E.title: "Мати предмети у своєму інвентарі"
	reward.4B4C26CECBBEE64A.title: "Досвід за виконання"
	quest.4BBD8FB8231C3C54.title: "Луска першого стража"
	quest.4BBD8FB8231C3C54.quest_desc: [
		"Знайди арену Наги та переможи її. Збережи здобич і переконайся, що гра видала відповідне досягнення."
	]
	task.4CB377BC4E56FE20.title: "Перемогти ціль"
	reward.4702EB627CFC6B6D.title: "Досвід за виконання"
	quest.49FB274872C56E97.title: "Вежа Сутінкового ліча"
	quest.49FB274872C56E97.quest_desc: [
		"Після Наги досліди вежу ліча. Придивись до щитів і снарядів: сама лише звичайна атака не вирішує кожну фазу."
	]
	task.45F9F71205CCC006.title: "Перемогти ціль"
	reward.436CA24612BE8119.title: "Досвід за виконання"
	quest.4404F5C153BF5803.title: "Лабіринт під болотом"
	quest.4404F5C153BF5803.quest_desc: [
		"Досліди підземний лабіринт і переможи Minoshroom. Не поспішай викидати здобич: вона пов’язана з подальшим відкриттям болотяної гілки."
	]
	task.4517A54EDC67EB10.title: "Перемогти ціль"
	reward.4EDA2317762522BE.title: "Досвід за виконання"
	quest.44490E9FF1A4EBA0.title: "Багатоголова загроза"
	quest.44490E9FF1A4EBA0.quest_desc: [
		"Пройди болотяну гілку прогресії та переможи Гідру. Вивчай моменти, коли бос вразливий."
	]
	task.4B3FE4BC76F6F613.title: "Перемогти ціль"
	reward.4C7514E416C572D5.title: "Досвід за виконання"
	quest.46E36E383E35A28B.title: "Лицарі під темним лісом"
	quest.46E36E383E35A28B.quest_desc: [
		"Відкрий доступ до підземної твердині темного лісу й переможи лицаря-примару. Для входу можуть знадобитися трофей та виконана прогресія."
	]
	task.4F5858D5C1535C44.title: "Перемогти ціль"
	reward.4CC6F5B36F3ABF7A.title: "Досвід за виконання"
	quest.492283F26DD1D032.title: "Верхівка темної вежі"
	quest.492283F26DD1D032.quest_desc: [
		"Піднімися до вершини темної вежі та переможи Ur-Ghast. Досліджуй механізми арени, а не лише атакуй здалеку."
	]
	task.4CCEF75ED0184B39.title: "Перемогти ціль"
	reward.4B16849DA0DDFEC7.title: "Досвід за виконання"
	quest.4F2DD11BB38BD2CC.title: "Сніг і лють"
	quest.4F2DD11BB38BD2CC.quest_desc: [
		"Відкрий снігову гілку після ліча та переможи Alpha Yeti у його лігві. Слідкуй за обвалами й простором для руху."
	]
	task.4C397A621672D56A.title: "Перемогти ціль"
	reward.4E837960A45562F0.title: "Досвід за виконання"
	quest.45A8ECA9BA6157D3.title: "Королева льоду"
	quest.45A8ECA9BA6157D3.quest_desc: [
		"Після Єті досліди льодовий палац і переможи Снігову королеву. Не забудь забрати трофей і перевірити досягнення."
	]
	task.4FFD28C9029743CC.title: "Перемогти ціль"
	reward.49B20A3855E38449.title: "Досвід за виконання"
	quest.45F0F1B33F995C6F.title: "Таємниці високогір’я"
	quest.45F0F1B33F995C6F.quest_desc: [
		"Після завершення доступних гілок відвідай високогір’я та досліди пізні споруди. Частина фінального контенту мода може бути незавершеною: книга не вимагає перемоги над неіснуючим фінальним босом."
	]
	task.4BDA029004B54163.title: "Підтвердити виконання вручну"
	chapter.4B24F701A9EC5373.title: "Artifacts: реліквії мандрівника"
	chapter.4B24F701A9EC5373.chapter_subtitle: [
		"Корисна здобич, яку цікавіше знайти, ніж скрафтити."
	]
	quest.4B1A13F835FE60ED.title: "Що ховається у скарбах"
	quest.4B1A13F835FE60ED.quest_desc: [
		"Артефакти трапляються як здобич і відрізняються ефектами. Досліджуй підземні табори та небезпечні місця, читай підказки й перевіряй слот спорядження. Конкретні знахідки залежать від випадкової генерації."
	]
	task.47D19BCE78A86578.title: "Підтвердити виконання вручну"
	quest.456896D81BD380EC.title: "Скриня з характером"
	quest.456896D81BD380EC.quest_desc: [
		"Знайди й переможи міміка. Обережно: не кожна скриня, що виглядає підозріло, є безпечною здобиччю."
	]
	task.416A63D6BC6528BA.title: "Перемогти ціль"
	reward.4D2D921432F85E93.title: "Досвід за виконання"
	quest.45F3185B9B61DF8E.title: "Запас життєвої сили"
	quest.45F3185B9B61DF8E.quest_desc: [
		"Знайди Crystal Heart і прочитай його ефект. Це необов’язковий колекційний виклик: не всі випадкові реліквії легко отримати в першій експедиції."
	]
	task.456067D663CD6625.title: "Мати предмети у своєму інвентарі"
	reward.4C29BA2B387C0204.title: "Досвід за виконання"
	quest.4AFE032E90B422DA.title: "Кігті шахтаря"
	quest.4AFE032E90B422DA.quest_desc: [
		"Знайди Digging Claws. Перевір ефект у спорядженому стані та порівняй швидкість видобутку зі звичайною."
	]
	task.4014906662D49581.title: "Мати предмети у своєму інвентарі"
	reward.43A06AB203B63179.title: "Досвід за виконання"
	quest.4619D0BF0F268382.title: "Сила в одній рукавичці"
	quest.4619D0BF0F268382.quest_desc: [
		"Здобудь Power Glove. Порівняй підказки різних реліквій і збери комплект під власний стиль гри."
	]
	task.4860AC41BC41D753.title: "Мати предмети у своєму інвентарі"
	reward.4402D6E7A67BE76B.title: "Досвід за виконання"
	quest.4243DA5570D07B1E.title: "Власна колекція пригод"
	quest.4243DA5570D07B1E.quest_desc: [
		"Збери три різні артефакти на вибір і облаштуй для них місце на базі. Цей вільний колекційний виклик підтверджується вручну; попередні конкретні реліквії можна шукати незалежно."
	]
	task.4CADB4C4B783701D.title: "Підтвердити виконання вручну"
}
